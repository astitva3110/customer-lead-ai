# --- Generation (LiteLLM) ---
GENERATION_PROVIDER=litellm
GENERATION_MODEL=ollama/qwen3:1.7b
GENERATION_API_BASE=http://127.0.0.1:11434
GENERATION_API_KEY=ollama
GENERATION_TEMPERATURE=0
GENERATION_CONVERSATION_TEMPERATURE=0.4
GENERATION_MAX_TOKENS=512
GENERATION_TIMEOUT_SECONDS=120
GENERATION_NUM_RETRIES=0
GENERATION_JSON_MODE=true
GENERATION_EXTRA_BODY={"think":false}
OPENAI_API_KEY=

# --- Semantic router (same Qwen 1.7B / GENERATION_MODEL via LiteLLM) ---
SEMANTIC_ROUTER_ENABLED=true
SEMANTIC_ROUTER_CONFIDENCE_THRESHOLD=0.7
SEMANTIC_ROUTER_MAX_TOKENS=256

# --- Required secrets / connections (do not commit real values) ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# --- Hybrid retrieval (chat) ---
HYBRID_RETRIEVAL_ENABLED=true
VECTOR_CANDIDATE_K=20
KEYWORD_CANDIDATE_K=20
FINAL_RETRIEVAL_K=5
RERANKER_MIN_SCORE=0.0
RERANKER_PROVIDER=lexical_overlap
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
KNOWLEDGE_VECTOR_TOP_K=20
KNOWLEDGE_KEYWORD_TOP_K=20
KNOWLEDGE_RERANKER_CANDIDATE_K=30
KNOWLEDGE_FINAL_CONTEXT_K=6
EMBEDDING_DEVICE=cpu

# Idle timeout for stored conversation state/history (minutes). 0 disables.
CONVERSATION_SESSION_TIMEOUT_MINUTES=15

# POST /chat auth: widget proxy token (same value as WIDGET_BACKEND_TOKEN in chatbot-frontend)
# or a valid staff JWT. Staff dashboard login tokens also work.
CHAT_SERVICE_TOKEN=

# Comma-separated browser origins. Empty disables CORS.
CORS_ALLOW_ORIGINS=https://earkart.com,https://www.earkart.com,https://earkart.in,https://www.earkart.in
CHANNEL_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
ORAI_SEND_URL=
ORAI_API_KEY=

# --- Chat diagnostics ---
CHAT_TRACE_ENABLED=false
CHAT_DEBUG_CONSOLE=false

# --- LangSmith (optional additional observability; does not replace ChatTrace) ---
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- KB pipeline (ingestion / embedding scripts) ---
# Fresh deployment: vector table is created empty at startup; admin upload populates it.
RETRIEVAL_CONFIG_PATH=configs/retrieval/v3_2_pgvector.yaml
EMBEDDING_PROVIDER=qwen_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=69da0546e10ee869fbf19f3b1d6c5ac12eb48a16
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
KB_DATASET_VERSION=phase16.2-v1
CHUNKING_ALGORITHM_VERSION=phase16.2.0
EMBEDDING_INPUT_MANIFEST=phase16-v1
EMBEDDING_VERSION=qwen_Qwen3-Embedding-0.6B_v1
VECTOR_TABLE=chunk_embeddings
PHASE12_VECTOR_TABLE=chunk_embeddings_v3_2
