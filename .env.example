# LiteLLM is the only generation gateway. Switch backends with these vars only.
GENERATION_PROVIDER=litellm

# Local Qwen via Docker Ollama (docker compose up -d ollama):
GENERATION_MODEL=ollama/qwen3:1.7b
GENERATION_API_BASE=http://127.0.0.1:11434
GENERATION_API_KEY=ollama
GENERATION_EXTRA_BODY={"think":false}

# OpenAI API:
# GENERATION_MODEL=openai/gpt-4o-mini
# GENERATION_API_BASE=
# GENERATION_API_KEY=sk-your-openai-key-here
# GENERATION_EXTRA_BODY=
OPENAI_API_KEY=

GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=512
GENERATION_TIMEOUT_SECONDS=120
GENERATION_NUM_RETRIES=0
GENERATION_JSON_MODE=true

# Crawl4AI settings (free, runs locally)
CRAWL_LIMIT=500
CRAWL_MAX_DEPTH=10

# Phase 11 — Qwen embedding + PGVector
EMBEDDING_PROVIDER=qwen_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=69da0546e10ee869fbf19f3b1d6c5ac12eb48a16
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=cuda
EMBEDDING_QUERY_INSTRUCTION=Given a user question about Earkart products, policies, or investor information, retrieve relevant passages that answer the question

KB_DATASET_VERSION=2026-08-17-v1
CHUNKING_ALGORITHM_VERSION=phase10.6
EMBEDDING_INPUT_MANIFEST=2026-08-17-v1
EMBEDDING_VERSION=qwen_Qwen3-Embedding-0.6B_v1

DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
VECTOR_TABLE=chunk_embeddings
VECTOR_SMOKE_TABLE=chunk_embeddings_smoke
VECTOR_BENCHMARK_TABLE=chunk_embeddings_benchmark

# Hybrid Retrieval V1
HYBRID_RETRIEVAL_ENABLED=true
VECTOR_CANDIDATE_K=20
KEYWORD_CANDIDATE_K=20
FINAL_RETRIEVAL_K=5
RERANKER_MIN_SCORE=0.0
RERANKER_PROVIDER=lexical_overlap
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
# Leave empty to follow EMBEDDING_DEVICE
# RERANKER_DEVICE=cuda

# Knowledge chat path (starting values only — not claimed optimal)
KNOWLEDGE_VECTOR_TOP_K=20
KNOWLEDGE_KEYWORD_TOP_K=20
KNOWLEDGE_RERANKER_CANDIDATE_K=30
KNOWLEDGE_FINAL_CONTEXT_K=6

# Chat diagnostics — observe-only. Keep disabled in production.
CHAT_TRACE_ENABLED=false
CHAT_TRACE_OUTPUT_DIR=reports/chat_traces
CHAT_TRACE_RETRIEVAL_TOP_K=10
CHAT_TRACE_INCLUDE_PROMPT=false
CHAT_TRACE_INCLUDE_FULL_CONTEXT=false
CHAT_TRACE_TEXT_PREVIEW_CHARS=500
CHAT_DEBUG_CONSOLE=false

# Authentication (JWT)
JWT_SECRET=dev-only-change-me-use-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
